# Postgres connection string (e.g. from a free Neon project)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

DEMO_MODE="true"
AUTH_SECRET="generate-with: openssl rand -base64 32"
PORTAL_URL="http://localhost:3000"
ADMIN_EMAILS="admin@yourschool.org"

# Google Sign-In (leave unset to stay in demo-login mode)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email sending (leave unset to log emails to the console instead of sending)
# RESEND_API_KEY=
# MAIL_FROM="Career Counselling <activities@yourschool.org>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Protects /api/cron/reminders from being triggered by randoms
# CRON_SECRET=
